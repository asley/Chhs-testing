# =============================================================================
# SECURITY WARNING: Do NOT commit .env file to version control!
# Copy this file to .env and fill in your actual values
# Add .env to .gitignore to prevent accidental commits
# =============================================================================

# Database Configuration
DB_SERVER=localhost
DB_PORT=3306
DB_NAME=chhs
DB_USER=root
DB_PASSWORD=your_secure_password_here_change_me
DB_SOCKET=/Applications/MAMP/tmp/mysql/mysql.sock

# Application Environment
APP_ENV=production
APP_DEBUG=false

# Security - CORS
# Set to your actual domain for production (not wildcard!)
CORS_ALLOWED_ORIGINS=https://yourdomain.edu

# Security - Session
SESSION_TIMEOUT=3600
SESSION_SECURE=true
SESSION_HTTPONLY=true
SESSION_SAMESITE=Strict

# Logging
LOG_PATH=/var/log/gibbon
ERROR_LOG=/var/log/php-errors.log
LOG_LEVEL=warning

# Email Configuration (if needed)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_email_password
MAIL_FROM=noreply@yourdomain.edu
